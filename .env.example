# Copy to .env and fill in. Never commit .env.

# n8n Cloud (source). Settings -> n8n API -> create key.
N8N_API_URL=https://your-name.app.n8n.cloud
N8N_API_KEY=

# Local n8n (destination). Create the key in the local UI after first start.
N8N_LOCAL_API_URL=http://localhost:5678
N8N_LOCAL_API_KEY=

# Locks saved logins inside local n8n. Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back it up somewhere safe. Lose it and every saved login is unrecoverable.
N8N_ENCRYPTION_KEY=

# Match your Cloud instance's time zone, or schedules fire at the wrong hour.
GENERIC_TIMEZONE=UTC

# Optional: public tunnel address once webhooks need to reach your machine.
# N8N_LOCAL_WEBHOOK_URL=https://your-tunnel.example.com/
